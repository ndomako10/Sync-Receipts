# Local config (contains machine name and username -- see Config/Templates/Config.template.ini)
Config/Config.ini
# Legacy config names -- kept ignored so upgrading users cannot accidentally commit them
Config/Config.env
Config/Config.bat

# Standalone utility -- not needed in the repo
Kill-Excel.bat

# Excel workbooks (contain personal financial data)
*.xlsx
*.xls

# Template files are safe to commit (no personal data)
!Accounts.template.xlsx
!Categories.template.json
!Methods.template.json

# Integration test fixture config is safe to commit (fictitious data only)
!Tests/Integration/Config/Accounts.xlsx
!Tests/Integration/Config/Categories.json
!Tests/Integration/Config/Methods.json

# Personal config files (may contain sensitive financial data)
Config/Accounts.xlsx
Config/Categories.json
Config/Methods.json

# Receipt files (personal financial documents)
Receipts/

# Claude Code local state
.claude/*
!.claude/commands/

# Test output logs
Tests/sync-output.txt
testResults.xml

