{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test: All",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Import-Module Pester -MinimumVersion 5.0 -Force; Invoke-Pester ./tests -Output Detailed"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Unit only",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Import-Module Pester -MinimumVersion 5.0 -Force; Invoke-Pester ./Tests/Sync-Receipts.Tests.ps1 -Output Detailed"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: Lint only",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Import-Module Pester -MinimumVersion 5.0 -Force; Invoke-Pester ./Tests/Lint.Tests.ps1 -Output Detailed"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync: Current month",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\Launchers\\Run-SyncReceipts.bat"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync: All months",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\Launchers\\Run-SyncAllReceipts.bat"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync: Test workbook (current month)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "call \"${workspaceFolder}\\Config\\Config.bat\" && powershell -NoProfile -ExecutionPolicy Bypass -NonInteractive -File \"${workspaceFolder}\\Scripts\\Sync-Receipts.ps1\" -ReceiptsRoot \"%RECEIPTS_ROOT_LOCAL%\" -WorkbookPath \"${workspaceFolder}\\Tests\\Receipts (test).xlsx\""
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sync: Current month (KillExcel)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "call \"${workspaceFolder}\\Config\\Config.bat\" && powershell -NoProfile -ExecutionPolicy Bypass -NonInteractive -File \"${workspaceFolder}\\Scripts\\Sync-Receipts.ps1\" -ReceiptsRoot \"%RECEIPTS_ROOT%\" -KillExcel"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
